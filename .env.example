# Copy this file to .env. Leave the key blank to run in free, offline fallback mode.
ANTHROPIC_API_KEY=
OPSPILOT_MODE=auto
OPSPILOT_EMBEDDINGS=tfidf

# Free option: any OpenAI-compatible API, e.g. Groq (console.groq.com, no credit card).
# OPSPILOT_LLM_PROVIDER=openai
# OPSPILOT_LLM_API_KEY=
# OPSPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1
# OPSPILOT_LLM_MODEL=openai/gpt-oss-120b
# Public demo: max LLM calls per day (0 = no limit)
# OPSPILOT_LLM_DAILY_CAP=200
